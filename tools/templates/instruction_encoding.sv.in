module instruction_encoding (
    input wire [127:0] words,
@PORTS@
    output wire [1:0] encoding_error
);
@WIRES@
    reg [127:0] allowed;
    reg known;
    always @* begin
        allowed=0; known=1;
        case (opcode)
@CASES@
            default: known=0;
        endcase
